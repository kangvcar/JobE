# 大模型：DeepSeek 官方接口（OpenAI 兼容）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_REVIEWER_MODEL=deepseek-reasoner

POSTGRES_DSN=postgresql://jobe:jobe@localhost:5432/jobe
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=jobe-dev-password

# 本体版本的唯一真源是 ontology/VERSION。不要在这里写死 v0，否则图谱查询会静默为空。
# ONTOLOGY_VERSION=0.1.0

# 采集频控。商业平台适配器默认关闭，开启前请阅读 docs/adr/0001。
COLLECT_DELAY_SECONDS=3.0
COLLECT_MAX_ITEMS=2000
LIEPIN_ENABLED=false
ZHIPIN_ENABLED=false
